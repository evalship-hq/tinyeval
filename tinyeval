#!/usr/bin/env bash
# tinyeval: evals for AI features, in one bash file. https://github.com/evalship-hq/tinyeval
# Runs on bash 3.2 (macOS) and up with the tools every bash install has. judge also needs curl.

_te_version=0.1.0
_te_usage="Usage: tinyeval [-n runs] [-o results.json] [eval files...]

Runs every test case in the eval files (default: evals/*.sh) and writes the
results to eval-results.json. Exits 1 when an eval fails.

  -n runs   run each eval this many times; it passes when at least half pass
  -o file   where to write the results (default: eval-results.json)
  -v        print the version"

_te_runs=1
_te_results=eval-results.json
while getopts n:o:vh _te_opt; do
  case $_te_opt in
    n) _te_runs=$OPTARG ;;
    o) _te_results=$OPTARG ;;
    v) echo "tinyeval $_te_version"; exit 0 ;;
    h) echo "$_te_usage"; exit 0 ;;
    *) echo "$_te_usage" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
case $_te_runs in '' | *[!0-9]* | 0) echo "tinyeval: -n takes a number of runs, 1 or more" >&2; exit 2 ;; esac
[ $# -gt 0 ] || set -- evals/*.sh
for _te_f in "$@"; do
  [ -f "$_te_f" ] || { echo "tinyeval: no eval file at $_te_f. Create one: https://github.com/evalship-hq/tinyeval#quickstart" >&2; exit 2; }
done

_te_tmp=$(mktemp -d) || exit 2
trap 'rm -rf "$_te_tmp"' EXIT
if [ -t 1 ]; then _te_g=$'\033[32m' _te_r=$'\033[31m' _te_y=$'\033[33m' _te_d=$'\033[2m' _te_0=$'\033[0m'; fi
_te_tab=$'\t'

# --- what an eval file uses ---------------------------------------------------

# test_case NAME [INPUT]: starts a test case. Without INPUT it reads one from stdin (a heredoc).
test_case() {
  local next_input
  if [ $# -ge 2 ]; then next_input=$2; else next_input=$(cat); fi
  _te_run_case
  _te_name=$1 _te_file=${BASH_SOURCE[1]} _te_asserts=() input=$next_input
}

contains() { _te_add _te_contains "$@"; }         # the reply contains TEXT, ignoring case
not_contains() { _te_add _te_not_contains "$@"; } # the reply doesn't contain TEXT, ignoring case
matches() { _te_add _te_matches "$@"; }           # the reply matches an extended regex
equals() { _te_add _te_equals "$@"; }             # the reply is exactly TEXT
expect() { _te_add _te_expect "$@"; }             # COMMAND exits 0 with the reply on its stdin
judge() { _te_add _te_judge "$@"; }               # a model says the reply meets CRITERION

# --- internals ----------------------------------------------------------------

_te_add() {
  [ -n "$_te_name" ] || { echo "tinyeval: ${1#_te_} comes before any test_case in ${BASH_SOURCE[2]}" >&2; return 1; }
  _te_asserts+=("$(printf '%q ' "$@")")
}

_te_fail() { _te_failures="${_te_failures:+$_te_failures$'\n'}$*"; }

_te_has() {
  shopt -s nocasematch
  [[ $output == *"$1"* ]]
  local found=$?
  shopt -u nocasematch
  return $found
}
_te_contains() { _te_has "$1" || _te_fail "expected to contain \"$1\""; }
_te_not_contains() { ! _te_has "$1" || _te_fail "expected not to contain \"$1\""; }
_te_matches() { [[ $output =~ $1 ]] || _te_fail "expected to match /$1/"; }
_te_equals() { [ "$output" = "$1" ] || _te_fail "expected exactly \"$1\""; }
_te_expect() {
  local said code
  said=$(printf '%s' "$output" | "$@" 2>&1) && return
  code=$?
  _te_fail "$*: $(printf '%s' "${said:-exited $code}" | tail -n 1)"
}

_te_judge() {
  local reply verdict
  reply=$(_te_ask_judge "You grade one reply from an AI feature against one criterion.

Criterion: $1

The input it got:
<input>
$input
</input>

Its reply:
<reply>
$output
</reply>

Does the reply meet the criterion? Answer PASS or FAIL on the first line, then one sentence on why.") ||
    { _te_fail "judge couldn't run: $reply"; return; }
  verdict=$(printf '%s\n' "$reply" | grep -m 1 -oE 'PASS|FAIL')
  reply=$(printf '%s' "$reply" | tr '\n' ' ' | sed -E 's/^[^A-Z]*(PASS|FAIL)[^[:alnum:]]*//' | cut -c 1-300)
  case $verdict in
    PASS) ;;
    FAIL) _te_fail "judge: $reply" ;;
    *) _te_fail "judge gave no PASS or FAIL: $reply" ;;
  esac
}

# A JSON string holding $1. Drops control characters but newline and tab, so ANSI colors lose their ESC.
_te_json() {
  local s bs='\\' q='\"' n='\n' t='\t'
  s=$(printf '%s' "$1" | tr -d '\000-\010\013-\037')
  s=${s//\\/"$bs"} s=${s//\"/"$q"} s=${s//$'\n'/"$n"} s=${s//$'\t'/"$t"}
  printf '"%s"' "$s"
}

# The string value of the last "KEY": "..." in JSON on stdin, still escaped.
# shortcut: a regex, not a parser; fine for one chat completion, use jq if this ever reads more.
_te_json_get() { tr -d '\n' | sed -nE 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)".*/\1/p'; }

# Prints the judge model's answer to $1, or why there is none and returns 1.
_te_ask_judge() {
  if [ -n "${TINYEVAL_JUDGE:-}" ]; then printf '%s' "$1" | sh -c "$TINYEVAL_JUDGE"; return; fi
  local url=${TINYEVAL_JUDGE_URL:-} key=${TINYEVAL_JUDGE_KEY:-} model=${TINYEVAL_JUDGE_MODEL:-} res content
  if [ -z "$url" ]; then
    if [ -n "${OPENROUTER_API_KEY:-}" ]; then
      url=https://openrouter.ai/api/v1 key=${key:-$OPENROUTER_API_KEY} model=${model:-anthropic/claude-haiku-5.5}
    elif [ -n "${ANTHROPIC_API_KEY:-}" ]; then
      url=https://api.anthropic.com/v1 key=${key:-$ANTHROPIC_API_KEY} model=${model:-claude-haiku-5-5}
    elif [ -n "${OPENAI_API_KEY:-}" ]; then
      url=https://api.openai.com/v1 key=${key:-$OPENAI_API_KEY}
    else
      echo "set OPENROUTER_API_KEY, ANTHROPIC_API_KEY or OPENAI_API_KEY, or TINYEVAL_JUDGE to a command"; return 1
    fi
  fi
  [ -n "$model" ] || { echo "set TINYEVAL_JUDGE_MODEL to the model the judge should use"; return 1; }
  command -v curl >/dev/null || { echo "judge needs curl, or TINYEVAL_JUDGE set to a command"; return 1; }
  # The key goes in a header file, not the command line, so it doesn't show in ps.
  (umask 077; printf 'Authorization: Bearer %s\n' "$key" >"$_te_tmp/auth")
  res=$(printf '{"model":%s,"messages":[{"role":"user","content":%s}]}' "$(_te_json "$model")" "$(_te_json "$1")" |
    curl -sS --max-time 120 "${url%/}/chat/completions" -H "@$_te_tmp/auth" -H 'Content-Type: application/json' --data-binary @- 2>&1) ||
    { echo "$res"; return 1; }
  content=$(printf '%s' "$res" | _te_json_get content)
  if [ -z "$content" ]; then
    content=$(printf '%s' "$res" | _te_json_get message)
    printf '%s' "${content:-$res}" | cut -c 1-300
    return 1
  fi
  printf '%s' "$content" | sed -e 's/\\[nrt]/ /g' -e 's/\\"/"/g' -e 's/\\\//\//g' -e 's/\\\\/\\/g'
}

# Milliseconds. bash 3.2 (macOS's /bin/bash) has no EPOCHREALTIME, so perl, then whole seconds.
_te_now() {
  if [ -n "${EPOCHREALTIME:-}" ]; then echo $((${EPOCHREALTIME/[.,]/} / 1000))
  else perl -MTime::HiRes=time -e 'printf "%d\n", time * 1000' 2>/dev/null || echo $(($(date +%s) * 1000)); fi
}

# Runs the test case test_case started: calls ask, then every assertion, once per run.
_te_run_case() {
  [ -n "$_te_name" ] || return 0
  local i=1 passes=0 started ms code a passed failure shown_failures shown_output
  local suite key file
  suite=$(_te_json "$_te_suite") key=$(_te_json "$_te_name") file=$(_te_json "$_te_file")
  while [ $i -le "$_te_runs" ]; do
    _te_failures= output=
    started=$(_te_now)
    if ! type ask >/dev/null 2>&1; then
      _te_fail "define ask in $_te_file: it gets the input as \$1 and on stdin, and prints the reply"
    else
      output=$(ask "$input" <<<"$input" 2>"$_te_tmp/ask.err")
      code=$?
      if [ $code -ne 0 ]; then
        _te_fail "ask failed (exit $code): $(tail -n 3 "$_te_tmp/ask.err" | tr '\n' ' ')"
      else
        for a in "${_te_asserts[@]}"; do eval "$a"; done
      fi
    fi
    ms=$(($(_te_now) - started))
    passed=true failure=
    if [ -z "$_te_failures" ]; then passes=$((passes + 1)); else
      passed=false failure=",\"failure\":$(_te_json "$_te_failures")" shown_failures=$_te_failures shown_output=$output
    fi
    # One eval per line with suite, key and passed first: the summary and the next run read them back with sed.
    printf '{"suite":%s,"key":%s,"passed":%s,"file":%s,"duration_ms":%s,"input":%s,"output":%s%s}\n' \
      "$suite" "$key" "$passed" "$file" "$ms" "$(_te_json "$input")" "$(_te_json "$output")" "$failure" >>"$_te_tmp/results.jsonl"
    i=$((i + 1))
  done

  local mark="${_te_g}✓" count=""
  [ "$_te_runs" -gt 1 ] && count=" $passes/$_te_runs"
  [ "$_te_runs" -eq 1 ] && count=" $(printf '%d.%ds' $((ms / 1000)) $((ms % 1000 / 100)))"
  if [ $((passes * 2)) -lt "$_te_runs" ]; then mark="${_te_r}✗"; elif [ "$passes" -lt "$_te_runs" ]; then mark="${_te_y}~"; fi
  printf '  %s%s %s%s%s\n' "$mark" "$_te_0" "$_te_name" "$_te_d" "$count$_te_0"
  if [ -n "$shown_failures" ]; then
    printf '%s\n' "$shown_failures" | sed 's/^/      /'
    printf '      %sreply: %s%s\n' "$_te_d" "$(printf '%s' "$shown_output" | tr '\n' ' ' | cut -c 1-200)" "$_te_0"
  fi
  _te_name=
}

# suite<TAB>key<TAB>true|false per eval line of a results file (or results.jsonl) on stdin.
_te_statuses() {
  sed -nE 's/^\{"suite":("([^"\\]|\\.)*"),"key":("([^"\\]|\\.)*"),"passed":(true|false).*/\1'"$_te_tab"'\3'"$_te_tab"'\5/p'
}

# suite<TAB>key<TAB>pass|fail per eval, in first-run order: the majority of its runs, as evalship counts repeats.
_te_majority() {
  awk -F '\t' '{ k = $1 FS $2; if (!(k in n)) order[++m] = k; n[k]++; if ($3 == "true") p[k]++ }
    END { for (i = 1; i <= m; i++) print order[i] FS (p[order[i]] * 2 >= n[order[i]] ? "pass" : "fail") }'
}

# --- run ------------------------------------------------------------------------

: >"$_te_tmp/results.jsonl"
for _te_f in "$@"; do
  _te_suite=$(basename "$_te_f" .sh)
  echo "$_te_suite"
  # A subshell per file, so one file's ask doesn't leak into the next.
  (_te_name=; . "$_te_f"; _te_run_case) </dev/null
done

_te_statuses <"$_te_tmp/results.jsonl" | _te_majority >"$_te_tmp/now"
_te_total=$(wc -l <"$_te_tmp/now" | tr -d ' ')
[ "$_te_total" -gt 0 ] || { echo "tinyeval: no test cases in $*" >&2; exit 2; }

if [ -f "$_te_results" ]; then
  _te_statuses <"$_te_results" | _te_majority >"$_te_tmp/was"
  awk -F '\t' -v g="$_te_g" -v r="$_te_r" -v z="$_te_0" '
    function show(s) { s = substr(s, 2, length(s) - 2); gsub(/\\"/, "\"", s); return s }
    NR == FNR { was[$1 FS $2] = $3; next }
    ($1 FS $2) in was && was[$1 FS $2] != $3 {
      if (!shown++) print "\nSince the last run"
      print "  " ($3 == "pass" ? g "✓" z : r "✗" z) " " show($1) " › " show($2) ($3 == "pass" ? " passes now" : " fails now")
    }' "$_te_tmp/was" "$_te_tmp/now"
fi
{ echo '{"evals": ['; sed '$!s/$/,/' "$_te_tmp/results.jsonl"; echo ']}'; } >"$_te_results"

_te_failed=$(grep -c "${_te_tab}fail\$" "$_te_tmp/now")
if [ "$_te_failed" -gt 0 ]; then
  printf '\n%s%s of %s evals failed%s %s(%s)%s\n' "$_te_r" "$_te_failed" "$_te_total" "$_te_0" "$_te_d" "$_te_results" "$_te_0"
  exit 1
fi
printf '\n%sAll %s evals passed%s %s(%s)%s\n' "$_te_g" "$_te_total" "$_te_0" "$_te_d" "$_te_results" "$_te_0"
